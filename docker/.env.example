# ===== ILD SemiSeg Tool - settings =====
# This is the one config file. `./manage.sh init` copies it to .env;
# edit .env, then `./manage.sh up` to apply.

# --- Address -----------------------------------------------------------------
# Where the site is served (everything is on this one address):
#   :80                     plain HTTP - testing, or a trusted internal network only
#   ild.your-site.example   real domain name: automatic HTTPS certificate
#                           (needs DNS pointing here and ports 80+443 reachable)
#   https://192.168.1.50    HTTPS with the gateway's own certificate (each
#                           browser shows a one-time warning to accept)
SITE_ADDRESS=:80
# Ports on this server PC that lead to the site. With a real domain, use 80/443.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Container engine ----------------------------------------------------------
# auto: Docker if it's running, otherwise Podman. Podman also works rootless
# (no admin rights) - see the README for what the server admin sets up once.
ENGINE=auto

# `./manage.sh up` opens the app in your browser when it can (desktop, or a
# VS Code remote terminal). no = only print the address.
OPEN_BROWSER=yes

# --- GPU ---------------------------------------------------------------------
# auto: use an NVIDIA GPU if the container engine can reach one, otherwise run on CPU.
# yes / no: force it. (No GPU on Macs; on Windows the GPU works through
# Docker Desktop's WSL 2 backend.) CPU works everywhere but AI runs take
# minutes instead of seconds. Re-run ./manage.sh build after changing this.
GPU=auto

# --- Models ------------------------------------------------------------------
# Folders/files on this server PC (relative paths are relative to docker/).
NNUNET_RESULTS_DIR=../Annotation_Tool_Test_Data/model_weights/nnUNet_results
SAM2_ILD_CHECKPOINT="../Annotation_Tool_Test_Data/model_weights/MedSAM2+nnUnet_results/Full Finetune_b4e60/checkpoint_best_val.pt"
MODELS=nnunet_lung,nnunet_ild,nnunet_airways,sam2_ild

# --- Logins ------------------------------------------------------------------
# How long a login stays valid on each device, in hours.
SESSION_HOURS=12

# --- Data --------------------------------------------------------------------
# Everything persistent lives here: accounts, every user's studies, saved
# segmentations, caches. This is the folder to back up.
DATA_DIR=./data

# AI image caches (a converted copy of every scan opened) not used for this many
# days are deleted by `./manage.sh up` / `clean`; they're re-downloaded from the
# user's Orthanc (10-20 s) the next time that scan is opened.
CACHE_DAYS=14

# Orthanc image used for every user's study store.
ORTHANC_IMAGE=docker.io/orthancteam/orthanc:latest

# --- Set by manage.sh from GPU= above - don't edit ----------------------------
# (Lets plain `docker compose ...` commands match what manage.sh runs.)
COMPOSE_FILE=docker-compose.yml:users.generated.yml
COMPOSE_PATH_SEPARATOR=:
TORCH_VARIANT=cpu
